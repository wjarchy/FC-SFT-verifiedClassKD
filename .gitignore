# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg

# Environment
.env
.venv/
venv/
env/

# IDE
.idea/
.vscode/
*.swp

# Data & artifacts (large files — track splits manifest only)
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/splits/**
!data/splits/.gitkeep
data/diagnostics/**
!data/diagnostics/.gitkeep
data/candidates/**
!data/candidates/.gitkeep
!data/candidates/README.md
data/cache/**
!data/cache/.gitkeep
!data/cache/README.md

# Model outputs
outputs/**
!outputs/.gitkeep

# Keep compact reports in git; exclude bulky per-example prediction dumps
reports/predictions/**
reports/**/*.jsonl
reports/**/*.parquet

# HF / torch cache
.cache/
hf_cache/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
tensorboard/
wandb/
